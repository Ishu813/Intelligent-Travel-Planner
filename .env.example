### Shared
# Postgres connection string (local docker default)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trip_planner

### API (Express)
PORT=3001
WEB_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key
# Stable model id (gemini-1.5-* is deprecated / often 503; we auto-upgrade in code)
GEMINI_MODEL=gemini-2.5-flash
# Optional: if primary stays overloaded after retries, try this model (e.g. gemini-2.0-flash)
# GEMINI_MODEL_FALLBACK=gemini-2.0-flash

### Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

### Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_a_long_random_string
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

