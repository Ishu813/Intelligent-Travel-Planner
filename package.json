{
  "name": "intelligent-travel-planner",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:web dev:api",
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "db:up": "docker compose up -d",
    "db:reset": "dotenv -e ./.env -- node db/reset-db.mjs",
    "db:migrate": "dotenv -e ./.env -- node db/run-migrations.mjs",
    "db:seed": "dotenv -e ./.env -- node db/run-seed.mjs",
    "build": "npm-run-all build:web build:api",
    "build:web": "npm --workspace web run build",
    "build:api": "npm --workspace api run build",
    "lint": "npm-run-all lint:web lint:api",
    "lint:web": "npm --workspace web run lint",
    "lint:api": "npm --workspace api run lint"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "dotenv-cli": "^8.0.0",
    "npm-run-all": "^4.1.5"
  }
}

